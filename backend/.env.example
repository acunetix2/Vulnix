# Vulnix backend environment.
# Copy this file to backend/.env (the API reads .env from its own working
# directory) and fill in real values. Never commit .env: it holds credentials
# that decrypt the stored integration tokens.

APP_ENV=development
VULNIX_APP_ENV=development
VULNIX_LOG_LEVEL=INFO

# Database (SQLite for local dev; Postgres plus migrations anywhere else)
VULNIX_DATABASE_URL=sqlite:///./.data/vulnix.db
# VULNIX_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/vulnix
VULNIX_DB_AUTO_CREATE=true

# Sign-in (Supabase). auth_disabled is a development convenience only and is
# refused when APP_ENV=production; the console then shows an all-zero account id
# because no real principal is verified.
VULNIX_AUTH_DISABLED=false
VULNIX_SUPABASE_URL=
VULNIX_SUPABASE_ANON_KEY=
VULNIX_SUPABASE_SERVICE_ROLE_KEY=
VULNIX_SUPABASE_JWT_SECRET=
VULNIX_SUPABASE_JWKS_URL=

# Queue. Keep eager=true until Redis is running, then set false and start a worker.
VULNIX_CELERY_BROKER_URL=redis://localhost:6379/0
VULNIX_CELERY_EAGER=true

# Object storage for quarantined archives
VULNIX_STORAGE_BACKEND=local
VULNIX_STORAGE_LOCAL_ROOT=./.data/storage
VULNIX_S3_ENDPOINT_URL=
VULNIX_S3_BUCKET=
VULNIX_S3_ACCESS_KEY=
VULNIX_S3_SECRET_KEY=

# Archive intake. A ZIP may be 100 MiB compressed, expand to 1 GiB, hold 10,000
# files, nest 20 deep, and contain no single entry over 64 MiB. Archives are
# quarantined for this many days when a scan never consumes them.
VULNIX_UPLOAD_MAX_BYTES=104857600
VULNIX_UPLOAD_MAX_UNCOMPRESSED_BYTES=1073741824
VULNIX_UPLOAD_MAX_ENTRY_BYTES=67108864
VULNIX_UPLOAD_MAX_FILES=10000
VULNIX_UPLOAD_MAX_NESTING_DEPTH=20
VULNIX_UPLOAD_MAX_COMPRESSION_RATIO=100
VULNIX_UPLOAD_RETENTION_DAYS=7
VULNIX_UPLOAD_RATE_PER_HOUR=20
VULNIX_SCAN_RATE_PER_HOUR=20

# Scan execution. Working directory is per-scan and deleted afterwards.
VULNIX_SCAN_WORKDIR=./.data/scans
VULNIX_SCAN_TOTAL_TIMEOUT_SECONDS=900
VULNIX_SCANNER_TIMEOUT_SECONDS=300
# Scanner binaries are fixed paths from here only - never taken from client
# input. A tool that is not installed is reported as skipped, not as a failure.
VULNIX_SEMGREP_PATH=semgrep
VULNIX_SEMGREP_CONFIG=auto
VULNIX_GITLEAKS_PATH=gitleaks
VULNIX_BANDIT_PATH=bandit
VULNIX_PIP_AUDIT_PATH=pip-audit
VULNIX_TRIVY_PATH=trivy

# AI explanations. ai_enabled is the master switch; with it off no model is
# probed and every explanation request returns AI_DISABLED.
VULNIX_AI_ENABLED=false
# "ollama" runs locally, "groq" is hosted, "none" turns provider selection off.
VULNIX_AI_PROVIDER=ollama
VULNIX_AI_BASE_URL=http://localhost:11434
# Default model for the chosen provider. Users only ever select a model the
# server probed and listed; an unavailable name here is ignored.
VULNIX_AI_MODEL=
# Provider API key. For a Groq primary this is the Groq credential.
VULNIX_AI_API_KEY=
VULNIX_AI_TIMEOUT_SECONDS=20
VULNIX_AI_NUM_CTX=4096
VULNIX_AI_MAX_SNIPPET_LINES=40
VULNIX_AI_RATE_PER_MINUTE=10
# One explanation attempt is one credit, counted per UTC day from stored usage
# events, so it survives a restart.
VULNIX_AI_DAILY_QUOTA_PER_USER=100
# Enable local-model reasoning for deeper reviews. Set true to prioritize speed.
VULNIX_AI_DISABLE_THINK=false

# Agent-first audits. Zero removes that agent budget; set a positive value only
# when this deployment needs a coverage or investigation cap. The scan deadline
# and AI quota still apply. Reads remain confined to validated repository files,
# search stays literal, and no repository code is executed.
VULNIX_AGENT_ENABLED=true
VULNIX_AGENT_MAX_FILES=0
VULNIX_AGENT_MAX_BYTES_PER_FILE=0
VULNIX_AGENT_MAX_CALLS=0
VULNIX_AGENT_MAX_INVESTIGATION_TURNS=0
VULNIX_AGENT_MAX_INVESTIGATION_CALLS=0
VULNIX_AGENT_MAX_CONTEXT_FILES=0
VULNIX_AGENT_RELATED_FILE_BYTES=0

# Groq: used as a primary provider (VULNIX_AI_PROVIDER=groq) or as the fallback
# tried when the primary is unreachable or misconfigured. A malformed model
# response is never retried elsewhere.
VULNIX_AI_FALLBACK_ENABLED=false
VULNIX_AI_FALLBACK_PROVIDER=groq
VULNIX_AI_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
VULNIX_AI_FALLBACK_MODEL=qwen/qwen3.8-27b
# Groq exposes a different model set per account, so the catalog only offers
# names that GET /models confirms for this key.
VULNIX_AI_FALLBACK_API_KEY=
VULNIX_AI_FALLBACK_TIMEOUT_SECONDS=30

# Outbound integrations (GitHub / Slack / Jira / webhooks).
# Off by default: workspace-supplied URLs are the main SSRF surface, so egress
# is a deliberate per-deployment choice. The address guards apply either way.
VULNIX_INTEGRATIONS_ENABLED=false
# Required when enabled - Fernet material for every stored credential and
# webhook signing secret. Losing it makes stored tokens undecryptable.
VULNIX_INTEGRATION_SECRET_KEY=
VULNIX_INTEGRATION_TIMEOUT_SECONDS=5
VULNIX_INTEGRATION_MAX_BODY_BYTES=65536
VULNIX_INTEGRATION_MAX_ATTEMPTS=5
VULNIX_INTEGRATION_BACKOFF_BASE_SECONDS=30
# Ceiling for one repository archive pulled from GitHub into quarantine.
VULNIX_INTEGRATION_FETCH_TIMEOUT_SECONDS=60
# Development only. Allows webhook targets that resolve to private addresses.
VULNIX_INTEGRATION_ALLOW_PRIVATE_TARGETS=false

# Create a GitHub App under Settings -> Developer settings -> GitHub Apps.
# Set its Setup URL to
#   {VULNIX_OAUTH_REDIRECT_BASE_URL}/api/v1/integrations/oauth/github/callback
# Grant repository Contents: Read-only (Metadata is always read-only). The
# installation flow lets GitHub account owners choose the repositories. Vulnix
# uses short-lived installation tokens and renews them server-side with the
# private key; do not commit the key or send it to the frontend.
VULNIX_GITHUB_APP_ID=
VULNIX_GITHUB_APP_SLUG=vulnix-reviewer
VULNIX_GITHUB_APP_PRIVATE_KEY=
# Keep GitHub OAuth credentials only if Supabase uses GitHub for user sign-in;
# repository integration uses the GitHub App settings above.
VULNIX_GITHUB_CLIENT_ID=
VULNIX_GITHUB_CLIENT_SECRET=
# Slack and Jira use OAuth authorization-code flows. A provider with missing
# credentials reports oauth_available=false and its Connect button is disabled.
VULNIX_SLACK_CLIENT_ID=
VULNIX_SLACK_CLIENT_SECRET=
VULNIX_JIRA_CLIENT_ID=
VULNIX_JIRA_CLIENT_SECRET=
# Public HTTPS origin of THIS API, no trailing slash. Register the matching
# Slack/Jira callback URLs in those provider apps; GitHub uses its Setup URL.
VULNIX_OAUTH_REDIRECT_BASE_URL=http://localhost:8000
# Where the browser is sent back to after a consent. Local Vite origin by
# default; set the deployed console URL in production.
VULNIX_CONSOLE_BASE_URL=http://localhost:5173
# How long a consent link stays valid before its signed state expires.
VULNIX_OAUTH_STATE_TTL_SECONDS=600
