# Vulnix backend environment. The API reads .env from its own working
# directory, so copy the full template at backend/.env.example to backend/.env
# and fill in real values there. This file is kept as the repo-level overview.
# Secrets never belong in version control.

APP_ENV=development
VULNIX_APP_ENV=development
VULNIX_LOG_LEVEL=INFO

# Database (SQLite for local dev; use Postgres in deployed environments)
VULNIX_DATABASE_URL=sqlite:///./.data/vulnix.db
# VULNIX_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/vulnix
VULNIX_DB_AUTO_CREATE=true

# Auth (Supabase). Never enable auth_disabled in production.
VULNIX_AUTH_DISABLED=true
VULNIX_SUPABASE_JWT_SECRET=
VULNIX_SUPABASE_JWKS_URL=

# Queue. Keep eager=true until Redis is running, then set false and start a worker.
VULNIX_CELERY_BROKER_URL=redis://localhost:6379/0
VULNIX_CELERY_EAGER=true

# Object storage
VULNIX_STORAGE_BACKEND=local
VULNIX_STORAGE_LOCAL_ROOT=./.data/storage
VULNIX_S3_ENDPOINT_URL=
VULNIX_S3_BUCKET=
VULNIX_S3_ACCESS_KEY=
VULNIX_S3_SECRET_KEY=

# Upload limits: 100 MiB compressed, 1 GiB uncompressed, 64 MiB per entry
VULNIX_UPLOAD_MAX_BYTES=104857600
VULNIX_UPLOAD_MAX_FILES=10000
VULNIX_UPLOAD_MAX_UNCOMPRESSED_BYTES=1073741824
VULNIX_UPLOAD_MAX_ENTRY_BYTES=67108864
VULNIX_UPLOAD_MAX_NESTING_DEPTH=20
VULNIX_UPLOAD_MAX_COMPRESSION_RATIO=100

# AI explanations. ai_enabled is the master switch; with it off no model is
# probed and every explanation request returns AI_DISABLED.
VULNIX_AI_ENABLED=false
# Default provider, used until a workspace picks a model of its own.
# "ollama" runs locally, "groq" is hosted, "none" turns provider selection off.
VULNIX_AI_PROVIDER=ollama
VULNIX_AI_BASE_URL=http://localhost:11434
# Default model name for the chosen provider. Users only ever select a model
# the server probed and listed; a name here that is not available is ignored.
VULNIX_AI_MODEL=
# Provider API key. For a Groq primary this is the Groq credential.
VULNIX_AI_API_KEY=
VULNIX_AI_TIMEOUT_SECONDS=20
# Local CPU context window. Large defaults make CPU inference crawl.
VULNIX_AI_NUM_CTX=4096
VULNIX_AI_MAX_SNIPPET_LINES=40
VULNIX_AI_RATE_PER_MINUTE=10
# One explanation attempt is one credit, counted per UTC day from stored usage
# events, so this survives a restart.
VULNIX_AI_DAILY_QUOTA_PER_USER=100
# Local models that advertise "thinking" can spend minutes on a JSON-only
# prompt. Keep this on unless you have measured the difference.
VULNIX_AI_DISABLE_THINK=true

# Hosted fallback, tried only when the primary is unreachable or misconfigured.
# A malformed model response is not retried elsewhere.
VULNIX_AI_FALLBACK_ENABLED=false
VULNIX_AI_FALLBACK_PROVIDER=groq
VULNIX_AI_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
VULNIX_AI_FALLBACK_MODEL=qwen/qwen3.8-27b
# Never committed. Groq exposes a different model set per account, so the
# catalog only offers names that GET /models confirms for this key.
VULNIX_AI_FALLBACK_API_KEY=
VULNIX_AI_FALLBACK_TIMEOUT_SECONDS=30

# Outbound integrations (Slack / Jira / webhooks).
# Off by default: workspace-supplied URLs are the main SSRF surface, so egress
# stays opt-in per deployment. The address guards apply either way.
VULNIX_INTEGRATIONS_ENABLED=false
# Required when enabled — Fernet material for stored credentials. Any long
# passphrase works; losing it makes stored tokens undecryptable.
VULNIX_INTEGRATION_SECRET_KEY=
VULNIX_INTEGRATION_TIMEOUT_SECONDS=5
VULNIX_INTEGRATION_MAX_BODY_BYTES=65536
VULNIX_INTEGRATION_MAX_ATTEMPTS=5
VULNIX_INTEGRATION_BACKOFF_BASE_SECONDS=30
# Development only. Allows webhook targets that resolve to private addresses.
VULNIX_INTEGRATION_ALLOW_PRIVATE_TARGETS=false

# OAuth apps (Slack / Jira / GitHub consent windows).
# Register one OAuth app per provider and paste its credentials here. These
# values never appear in the console or an API response, and a provider with an
# empty pair simply reports oauth_available=false so its Connect button is not
# offered.
VULNIX_GITHUB_CLIENT_ID=
VULNIX_GITHUB_CLIENT_SECRET=
VULNIX_SLACK_CLIENT_ID=
VULNIX_SLACK_CLIENT_SECRET=
VULNIX_JIRA_CLIENT_ID=
VULNIX_JIRA_CLIENT_SECRET=
# Public HTTPS origin of THIS API, no trailing slash. Each provider's app must
# allow exactly {base}/api/v1/integrations/oauth/{provider}/callback.
VULNIX_OAUTH_REDIRECT_BASE_URL=
# Where the browser is sent back to after a consent. Local Vite dev origin by
# default; set the deployed console URL in production.
VULNIX_CONSOLE_BASE_URL=http://localhost:5173
# How long a consent link stays valid before its signed state expires.
VULNIX_OAUTH_STATE_TTL_SECONDS=600
# Ceiling for one repository archive pulled from GitHub into quarantine.
VULNIX_INTEGRATION_FETCH_TIMEOUT_SECONDS=60
