# API Configuration.
# Empty means the console talks to /api/v1 on its own origin: locally that is the
# Vite dev proxy, and on a deployment it needs the API behind the same hostname.
# When the console and the API are hosted on different origins, set the absolute
# URL here and list this console's own origin in the API's VULNIX_CORS_ALLOW_ORIGINS
# (ADR-022). The value is compiled into the bundle, so a Pages deploy only picks up
# a change to it after a rebuild.
VITE_API_BASE_URL=/api/v1

# App Configuration
VITE_APP_NAME=Vulnix
VITE_APP_VERSION=0.1.0
